{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Land record extract (7/12 or 8A)",
  "description": "Every field is {value, confidence}. value is null when the document does not contain it. Owner names are never written to the public repo.",
  "type": "object",
  "properties": {
    "survey_number": {"$ref": "#/$defs/field"},
    "village": {"$ref": "#/$defs/field"},
    "area_sqm": {"$ref": "#/$defs/field"},
    "owner_count": {"$ref": "#/$defs/field"},
    "encumbrances": {"$ref": "#/$defs/field"},
    "mutation_entries": {"$ref": "#/$defs/field"},
    "crop_entries": {"$ref": "#/$defs/field"}
  },
  "$defs": {"field": {"type": "object", "required": ["value", "confidence"],
    "properties": {"value": {}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}}
}
